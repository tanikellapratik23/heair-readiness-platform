generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum StakeholderRole {
  student
  faculty
  executive_leadership
  administrative_staff
  programming_staff
  finance_staff
  // Retained while existing saved accounts and sessions are migrated.
  leadership
  business_affairs
  it_staff
  // Legacy values are retained only so existing saved records remain readable.
  communications
  administrator_leadership
  academic_business_affairs_staff
}

enum SystemRole {
  self
  admin
  dept_viewer
}
enum SessionStatus {
  in_progress
  completed
  abandoned
}
enum QuestionType {
  likert_5
  multiple_choice
  yes_no
  free_text
}
enum RecommendationCategory {
  strength
  weakness
  priority_action
  resource
}
enum KnowledgeSourceType {
  heair_paper
  framework
  research_paper
  best_practice
}
enum MethodologyApprovalStatus {
  draft
  approved
  retired
}
enum ActionPlanStatus {
  not_started
  planned
  in_progress
  completed
  dismissed
}

model Institution {
  id String @id @default(uuid()) @db.Uuid
  name String @unique
  unitLabel String @default("Department or unit")
  createdAt DateTime @default(now())
  departments Department[]
  users User[]
  methodologies AssessmentMethodology[]
}

model Department {
  id String @id @default(uuid()) @db.Uuid
  institutionId String @db.Uuid
  name String
  createdAt DateTime @default(now())
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  users User[]
  aggregateScores DepartmentAggregateScore[]
  @@unique([institutionId, name])
}

model User {
  id String @id @default(uuid()) @db.Uuid
  email String @unique
  passwordHash String
  fullName String?
  role StakeholderRole?
  unitName String?
  systemRole SystemRole @default(self)
  departmentId String? @db.Uuid
  institutionId String? @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  department Department? @relation(fields: [departmentId], references: [id])
  institution Institution? @relation(fields: [institutionId], references: [id])
  sessions AssessmentSession[]
  stakeholderRoles UserStakeholderRole[]
  conversations ChatConversation[]
  actionPlanItems ActionPlanItem[]
  exportAuditLogs ExportAuditLog[]
}

model UserStakeholderRole {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  role StakeholderRole
  approvedAt DateTime?
  verificationPending Boolean @default(false)
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([userId, role])
  @@index([role])
}

model Dimension {
  id String @id
  label String
  description String
  sortOrder Int
  subDimensions SubDimension[]
  scores DimensionScore[]
  aggregates DepartmentAggregateScore[]
  assessmentComments AssessmentDimensionComment[]
  actionPlanItems ActionPlanItem[]
}

model SubDimension {
  id String @id
  dimensionId String
  label String
  description String
  sortOrder Int
  dimension Dimension @relation(fields: [dimensionId], references: [id])
  questions Question[]
  scores SubDimensionScore[]
  recommendations Recommendation[]
  actionPlanItems ActionPlanItem[]
}

model Question {
  id String @id @default(uuid()) @db.Uuid
  role StakeholderRole
  subDimensionId String
  prompt String
  helpText String?
  questionType QuestionType @default(likert_5)
  options Json?
  scoringKey Json?
  isAdaptiveSeed Boolean @default(false)
  weight Decimal @default(1) @db.Decimal(8,2)
  active Boolean @default(true)
  sessionScoped Boolean @default(false)
  allowNotApplicable Boolean @default(true)
  allowDepartmentScope Boolean @default(true)
  createdAt DateTime @default(now())
  subDimension SubDimension @relation(fields: [subDimensionId], references: [id])
  responses QuestionResponse[]
  triggerRules FollowUpRule[] @relation("TriggerQuestion")
  followUpFor FollowUpRule[] @relation("FollowUpQuestion")
}

model FollowUpRule {
  id String @id @default(uuid()) @db.Uuid
  triggerQuestionId String @db.Uuid
  triggerCondition Json
  followUpQuestionId String? @db.Uuid
  followUpPromptTemplate String?
  triggerQuestion Question @relation("TriggerQuestion", fields: [triggerQuestionId], references: [id], onDelete: Cascade)
  followUpQuestion Question? @relation("FollowUpQuestion", fields: [followUpQuestionId], references: [id])
}

model AssessmentSession {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  roleAtTime StakeholderRole
  departmentIdAtTime String? @db.Uuid
  unitNameAtTime String?
  methodologyVersion String @default("heair-v1-provisional")
  clientSubmissionId String? @unique @db.Uuid
  status SessionStatus @default(in_progress)
  startedAt DateTime @default(now())
  completedAt DateTime?
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  responses QuestionResponse[]
  scoreResult ScoreResult?
  report ReadinessReport?
  dimensionComments AssessmentDimensionComment[]
  conversations ChatConversation[]
  actionPlanItems ActionPlanItem[]
}

model AssessmentDimensionComment {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  dimensionId String
  text String @db.VarChar(1200)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id])
  @@unique([sessionId, dimensionId])
}

model QuestionResponse {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @db.Uuid
  questionId String @db.Uuid
  responseValue Json
  isFollowUp Boolean @default(false)
  generatedQuestionText String?
  parentResponseId String? @db.Uuid
  createdAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  question Question @relation(fields: [questionId], references: [id])
  parentResponse QuestionResponse? @relation("ResponseThread", fields: [parentResponseId], references: [id])
  children QuestionResponse[] @relation("ResponseThread")
  @@unique([sessionId, questionId])
}

model ScoreResult {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @unique @db.Uuid
  overallScore Decimal @db.Decimal(5,2)
  methodologyVersion String @default("heair-v1-provisional")
  scoredResponseCount Int @default(0)
  excludedResponseCount Int @default(0)
  responseCoveragePercent Int @default(0)
  computedAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  dimensionScores DimensionScore[]
  subDimensionScores SubDimensionScore[]
}

model DimensionScore {
  id String @id @default(uuid()) @db.Uuid
  scoreResultId String @db.Uuid
  dimensionId String
  score Decimal @db.Decimal(5,2)
  scoreResult ScoreResult @relation(fields: [scoreResultId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id])
  @@unique([scoreResultId, dimensionId])
}

model SubDimensionScore {
  id String @id @default(uuid()) @db.Uuid
  scoreResultId String @db.Uuid
  subDimensionId String
  score Decimal @db.Decimal(5,2)
  responseCount Int
  scoreResult ScoreResult @relation(fields: [scoreResultId], references: [id], onDelete: Cascade)
  subDimension SubDimension @relation(fields: [subDimensionId], references: [id])
  @@unique([scoreResultId, subDimensionId])
}

model KnowledgeDocument {
  id String @id @default(uuid()) @db.Uuid
  sourceTitle String
  sourceType KnowledgeSourceType
  sourceUrlOrCitation String?
  publisher String?
  publishedAt DateTime?
  rawText String
  createdAt DateTime @default(now())
  chunks KnowledgeChunk[]
}

model KnowledgeChunk {
  id String @id @default(uuid()) @db.Uuid
  documentId String @db.Uuid
  chunkText String
  chunkIndex Int
  // JSON keeps the MVP compatible with managed PostgreSQL. Replace with pgvector
  // in a dedicated migration when semantic retrieval is enabled in production.
  embedding Json?
  metadata Json?
  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  @@unique([documentId, chunkIndex])
}

model ReadinessReport {
  id String @id @default(uuid()) @db.Uuid
  sessionId String @unique @db.Uuid
  overallScore Decimal @db.Decimal(5,2)
  summaryText String
  structuredData Json?
  generatedAt DateTime @default(now())
  session AssessmentSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  recommendations Recommendation[]
}

model Recommendation {
  id String @id @default(uuid()) @db.Uuid
  reportId String @db.Uuid
  category RecommendationCategory
  subDimensionId String?
  title String
  description String
  supportingCitationIds String[] @db.Uuid
  sortOrder Int
  report ReadinessReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  subDimension SubDimension? @relation(fields: [subDimensionId], references: [id])
}

model DepartmentAggregateScore {
  id String @id @default(uuid()) @db.Uuid
  departmentId String @db.Uuid
  dimensionId String
  avgScore Decimal @db.Decimal(5,2)
  sampleSize Int
  periodStart DateTime @db.Date
  periodEnd DateTime @db.Date
  department Department @relation(fields: [departmentId], references: [id], onDelete: Cascade)
  dimension Dimension @relation(fields: [dimensionId], references: [id])
  @@unique([departmentId, dimensionId, periodStart, periodEnd])
}

model AssessmentMethodology {
  id String @id @default(uuid()) @db.Uuid
  version String @unique
  title String
  owner String
  citation String?
  sourceUrl String?
  approvalStatus MethodologyApprovalStatus @default(draft)
  approvedAt DateTime?
  configuration Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  institutionId String? @db.Uuid
  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: SetNull)
}

model ChatConversation {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  assessmentSessionId String? @db.Uuid
  title String @db.VarChar(180)
  methodologyVersion String @default("heair-v1-provisional")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentSession AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: SetNull)
  messages ChatMessage[]
  @@index([userId, updatedAt])
}

model ChatMessage {
  id String @id @default(uuid()) @db.Uuid
  conversationId String @db.Uuid
  role String @db.VarChar(20)
  content String @db.VarChar(4000)
  sources Json?
  createdAt DateTime @default(now())
  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  @@index([conversationId, createdAt])
}

model ActionPlanItem {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  assessmentSessionId String? @db.Uuid
  title String @db.VarChar(180)
  whyItMatters String @db.VarChar(1200)
  dimensionId String?
  subDimensionId String?
  assessmentEvidence String? @db.VarChar(1200)
  suggestedOwner String? @db.VarChar(180)
  suggestedDeadline DateTime? @db.Date
  status ActionPlanStatus @default(not_started)
  example String? @db.VarChar(1200)
  supportingSources Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessmentSession AssessmentSession? @relation(fields: [assessmentSessionId], references: [id], onDelete: SetNull)
  dimension Dimension? @relation(fields: [dimensionId], references: [id])
  subDimension SubDimension? @relation(fields: [subDimensionId], references: [id])
  @@index([userId, status])
}

model ExportAuditLog {
  id String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid
  exportType String @db.VarChar(80)
  scope Json
  createdAt DateTime @default(now())
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId, createdAt])
}
